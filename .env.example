APP_DEBUG=false
APP_ENV=local

DB_HOST=127.0.0.1
DB_NAME=life_story
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_PREFIX=ls_

CACHE_TYPE=file

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change_me_to_a_long_random_secret_string

WECHAT_APPID=
WECHAT_SECRET=

OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_DOMAIN=

AI_ASR_API=
AI_LLM_API=
AI_TTS_API=
AI_IMAGE_API=

# ===== AI 网关 =====
# 总开关：true = 所有 AI 通道都走本地 mock（零配置可跑通全流程）；
#         false = 按下各通道 api 真实调用第三方接口
AI_MOCK=true

# 章节录音引导（引导式口述提示，OpenAI Chat Completions 兼容）
# 对接 DeepSeek 示例：
#   AI_GUIDANCE_API=https://api.deepseek.com/chat/completions
#   AI_GUIDANCE_KEY=sk-xxxx
#   AI_GUIDANCE_MODEL=deepseek-chat
# 注意：必须同时设 AI_MOCK=false，否则总开关会让它继续走 mock。
# 第三方不可用（key 错/超时/网络）时会静默退回本地 mock 文案，页面不报错
# —— 想确认「到底有没有真的调用」，跑：php tests/_check_ai.php
AI_GUIDANCE_API=
AI_GUIDANCE_KEY=
AI_GUIDANCE_MODEL=deepseek-chat
AI_GUIDANCE_TIMEOUT=30

# ===== 语音识别（录音转文字）=====
# driver=tencent：腾讯云「录音文件识别极速版」（同步返回，一次 HTTPS POST 拿结果）
#   - 开通：语音识别控制台 → 录音文件识别 服务开通
#   - 凭据：控制台「API 密钥管理」（= 访问管理 → API 密钥管理）新建，得到 SecretId / SecretKey；
#           AppID 用账号的 AppID（控制台应用详情里也有）
#   - 支持格式：wav / pcm / ogg-opus / speex / silk / mp3 / m4a / aac / amr（⚠️ 不支持 webm）
#     新版 Chrome/Safari/微信录出的是 m4a，可直接送；老浏览器录成 webm 时，
#     要么装 ffmpeg（自动转码），要么让前端优先选 audio/mp4 容器
#   - 缺任一凭据 → 自动回退本地 mock 文案；确认是否真的调用了：php tests/_check_asr_tencent.php
# driver=generic：走 AI_ASR_API 的通用 JSON 协议（{model,format,audio_base64} + Bearer key）
AI_ASR_DRIVER=tencent
AI_ASR_TENCENT_APPID=
AI_ASR_TENCENT_SECRET_ID=
AI_ASR_TENCENT_SECRET_KEY=
# 引擎：16k_zh 中文通用 / 16k_zh_en 大模型1.0版（中英粤+9 方言） / 16k_zh_dialect 多方言
AI_ASR_TENCENT_ENGINE=16k_zh
# 临时热词表（人名/地名明显提准）：格式「热词 + 竖线 + 权重」，多词英文逗号分隔，权重 1-11（11=超级热词）
# ⚠️ 注释里千万不要写竖线字符：PHP ini 解析器会因此判定整个 .env 解析失败，导致全部环境变量丢失
AI_ASR_TENCENT_HOTWORDS=
AI_ASR_TENCENT_TIMEOUT=120
# ffmpeg 路径（仅 webm 转码用，留空自动探测 PATH）
AI_ASR_FFMPEG=

# HTTPS 证书校验：默认 true。若本机 PHP 没配 php.ini 的 curl.cainfo，
# 会自动探测 backend/runtime/ca/cacert.pem（项目自带 Mozilla CA 包）。
# AI_SSL_VERIFY=false 可关闭校验（仅本机排障，生产禁止）；
# AI_SSL_CA 可显式指定根证书路径。
AI_SSL_VERIFY=true
AI_SSL_CA=

# 兑换码明文加密密钥（AES-256-CBC）。用于把生成时的明文码加密落库，
# 支撑「事后/定期导出」。务必生产环境配置为强随机值；
# 未配置时退回开发默认密钥（仅本地可用，密钥一旦变更旧码将无法解密）。
CODE_CIPHER_KEY=
