# 自动生成，请勿手改（改 deploy-h5.mjs）
# 前端 SPA 部署在子目录 /h5/：任何「不是真实文件」的路径都回退到 index.html，
# 这样 /h5/memoirs/72 这类前端路由刷新才不会是 404。
# 站点根的 .htaccess 必须用 RewriteCond %{REQUEST_URI} !^/h5/ 把 /h5/* 让出来，
# 否则请求会先被根规则改写成 index.php/<path>，进 ThinkPHP 后 404。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /h5/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# 带 hash 的静态资源可长期强缓存（文件名变了才会重新拉）
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
