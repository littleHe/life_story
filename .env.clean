APP_DEBUG=true
APP_ENV=local

# 数据库
DB_HOST=127.0.0.1
DB_NAME=life_story
DB_USER=root
DB_PASS=DB_PORT=3306
DB_PREFIX=ls_

# 缓存(限流/锁定用 predis 直连，见 config/redis.php；此处仅框架 cache 默认)
CACHE_TYPE=file

# Redis / Predis(纯 PHP，无需 phpredis 扩展)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_DB=0

# JWT 签名密钥(务必修改为随机长串)
JWT_SECRET=change_me_to_a_long_random_secret_string

# 微信(公众号 H5 网页授权)
WECHAT_APPID=WECHAT_SECRET=# 对象存储(OSS/COS)——录音/图片/音频直传
OSS_BUCKET=OSS_ENDPOINT=OSS_ACCESS_KEY=OSS_SECRET_KEY=OSS_DOMAIN=# 云 AI(示例：腾讯云/讯飞/通义，按实际替换)
AI_ASR_API=AI_LLM_API=AI_TTS_API=AI_IMAGE_API=