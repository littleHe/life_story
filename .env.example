# ============================================================
#  人生回忆录 · 环境配置模板
#  用法：cp .env.example .env  然后按注释填真实值
#
#  ⚠️ 本文件是 PHP ini 格式，两条铁律：
#    1、注释必须整行以 # 开头，绝不能写在值的后面 —— 行内注释会让整行规则失效
#    2、值或注释里都不要出现这些 ASCII 字符：半角圆括号、单双引号、竖线、与号、
#       波浪号、感叹号、方括号、花括号、脱字符、美元符、问号
#       它们会让 PHP 判定整个 .env 解析失败，结果是「所有环境变量突然全丢」，
#       而且页面不报错、只是悄悄退回默认值，极难排查
# ============================================================

# 环境：线上必须 production —— 该模式下自动关闭「测试登录」入口，只走真实微信授权
APP_ENV=production
APP_DEBUG=false

# 站点正式域名（生成「预览地址」等绝对链接用）。线上必填，例：https://hsm.your-domain.com
# 留空会回落「当前请求域名」：本地开发时请求域名是 127.0.0.1:9411，会把本机地址写进库，
# 数据导到线上后预览必然打不开。故线上务必填真实域名。
APP_URL=

# ---------------- 数据库 ----------------
# ⚠️ DB_PREFIX 必须留空：代码里表名已经写成 ls_project 这种全名形式，
#    再填 ls_ 前缀会拼成 ls_ls_project，全站立刻 500。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=life_story
DB_USER=
DB_PASS=
DB_PREFIX=

# ---------------- 缓存 / Redis ----------------
CACHE_TYPE=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------- 登录令牌 ----------------
# 务必换成 32 位以上随机串，改动后旧 token 全部失效
JWT_SECRET=change_me_to_a_long_random_string

# ---------------- 微信公众号（真实网页授权登录）----------------
# 公众号后台 → 设置与开发 → 基本配置：拿 AppID / AppSecret
# 同一后台 → 功能设置 → 网页授权域名：填线上域名，且需上传校验文件
WECHAT_APPID=
WECHAT_SECRET=
# 网页授权作用域：snsapi_userinfo 可取昵称头像；snsapi_base 仅拿 openid
WECHAT_SCOPE=snsapi_userinfo

# ---------------- 对象存储（留空即用本机 public/uploads）----------------
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_DOMAIN=

# ---------------- 兑换码明文加密密钥 ----------------
# AES-256-CBC。用于把生成时的明文码加密落库，支撑事后导出。
# 务必填强随机值；不填会退回开发默认密钥，且密钥一旦变更旧码将无法解密。
CODE_CIPHER_KEY=

# ============================================================
#  AI 能力
# ============================================================
# 总开关：false = 调真实第三方接口；true = 全部走本地 mock
# 注意：mock 模式下页面照样出文字出图，看不出差别，只在后台任务表能看出端倪
AI_MOCK=false

# HTTPS 证书校验：保持 true。若本机 php.ini 没配 curl.cainfo，
# 程序会自动探测 backend/runtime/ca/cacert.pem，无需手填。
AI_SSL_VERIFY=true
AI_SSL_CA=

# ---------------- 文本润色（LLM，OpenAI Chat Completions 兼容）----------------
# ⚠️ 只填 API 不填 KEY 不会报错，会静默退回本地 mock 文案 —— 务必三项填全
AI_LLM_API=https://api.deepseek.com/chat/completions
AI_LLM_KEY=
AI_LLM_MODEL=deepseek-chat
AI_LLM_TIMEOUT=60

# ---------------- 章节讲述引导（LLM，可复用上面同一个 key）----------------
AI_GUIDANCE_API=https://api.deepseek.com/chat/completions
AI_GUIDANCE_KEY=
AI_GUIDANCE_MODEL=deepseek-chat
AI_GUIDANCE_TIMEOUT=30

# ---------------- 语音识别 ASR（录音转文字）----------------
# driver = tencent 走腾讯云「录音文件识别极速版」（推荐）
# driver = generic 走下方 AI_ASR_API 的通用协议
AI_ASR_DRIVER=tencent
AI_ASR_API=
AI_ASR_KEY=
AI_ASR_MODEL=
AI_ASR_TEXT_PATH=
AI_ASR_TIMEOUT=30

# 腾讯云 API 密钥：访问管理 → API 密钥管理，新建后得 SecretId / SecretKey
# AppID 用主账号的 AppID（控制台账号信息里能看到），填错会报 4002
AI_ASR_TENCENT_APPID=
AI_ASR_TENCENT_SECRET_ID=
AI_ASR_TENCENT_SECRET_KEY=
# 引擎：16k_zh 中文通用（免费）；16k_zh_en 大模型版（中英粤加方言，口音重的老人更准，可能计费）
AI_ASR_TENCENT_ENGINE=16k_zh
# 临时热词表，提升人名地名识别率。格式为 热词 加 竖线 加 权重，多词用英文逗号分隔，权重 1 到 11
AI_ASR_TENCENT_HOTWORDS=
AI_ASR_TENCENT_TIMEOUT=120
# ffmpeg 可执行文件路径，仅老浏览器录出 webm 时用于转码；留空自动探测 PATH
AI_ASR_FFMPEG=

# ---------------- 章节配图（腾讯混元生图）----------------
# 凭证默认复用上面的 AI_ASR_TENCENT_SECRET_ID / SECRET_KEY，同账号云 API 密钥。
# 产品线固定用 aiart（控制台的「腾讯混元生图」免费资源包就挂在这条线上）。
# 旧的 hunyuan 产品线现已恒报「服务未开通」，不要再切回去。
AI_IMAGE_DRIVER=tencent_hunyuan
AI_IMAGE_TENCENT_PRODUCT=aiart
AI_IMAGE_TENCENT_ENDPOINT=aiart.tencentcloudapi.com
AI_IMAGE_TENCENT_VERSION=2022-12-29
AI_IMAGE_TENCENT_SERVICE=aiart
AI_IMAGE_TENCENT_SUBMIT_ACTION=SubmitTextToImageJob
AI_IMAGE_TENCENT_QUERY_ACTION=QueryTextToImageJob
# 地域必须是 ap-guangzhou，其它地域会找不到资源包
AI_IMAGE_TENCENT_REGION=ap-guangzhou
# 出图分辨率，例 1024:768
AI_IMAGE_TENCENT_RESOLUTION=1024:768
# 提示词扩写：开启效果更好，每张多约 20 秒
AI_IMAGE_TENCENT_REVISE=1
# 结果图右下角「图片由 AI 生成」水印：1 加 / 0 不加
AI_IMAGE_TENCENT_LOGO_ADD=1
# 单次请求内等待出图的秒数上限，超时返回 pending 稍后续跑
AI_IMAGE_TENCENT_WAIT_MAX=90
AI_IMAGE_TENCENT_POLL_INTERVAL=3
AI_IMAGE_TENCENT_TIMEOUT=60
# generic 通道（自建或其它厂商文生图网关）时才用
AI_IMAGE_API=
AI_IMAGE_KEY=
AI_IMAGE_MODEL=

# ---------------- 章节朗读配音（腾讯云语音合成 TTS）----------------
# 凭证同样默认复用上面的腾讯云密钥。
# ⚠️ 需先在语音合成控制台领取免费资源包，否则一律 PkgExhausted，声音出不来（与代码无关）
AI_TTS_DRIVER=tencent
AI_TTS_API=
AI_TTS_KEY=
# 按传主性别分派的标准音色：男 501006 千嶂 沉稳；女 601010 爱小娇 温柔
AI_TTS_VOICE_MALE=501006
AI_TTS_VOICE_FEMALE=601010
AI_TTS_TENCENT_CODEC=mp3
AI_TTS_TENCENT_SAMPLE_RATE=16000
AI_TTS_TENCENT_SPEED=0
AI_TTS_TENCENT_VOLUME=0
AI_TTS_TENCENT_TIMEOUT=60

# ---------------- 声音复刻 VRS（用传主原声朗读）----------------
# 默认关闭：需先在语音合成控制台开通「声音复刻」，按音色计费。
# 关闭时按性别使用上面的标准音色，交付不受影响。
AI_VRS_ENABLED=0
AI_VRS_SAMPLE_SEC=12
AI_VRS_TENCENT_TIMEOUT=60
